  m_Script: {fileID: 11500000, guid: 20f024b11fd2a5544a04e1bbbb7c657b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    name:
    - "Ana e Jos\xE9: "
    - "Jo\xE3o: "
    - "Jos\xE9: "
    - "Jo\xE3o: "
    - "Jos\xE9: "
    sentences:
    - "Bom dia, Jo\xE3o!"
    - "Bom dia vov\xF4 e vov\xF3!"
    - "Viu a not\xEDcia sobre o novo v\xEDrus que tem o potencial de gerar uma pandemia
      global?"
    - "N\xE3o vi. O que diz a reportagem?"
    - "Recentemente foi detectado um novo tipo de v\xEDrus da fam\xEDlia Coronav\xEDrus,
      SARS-CoV-2. Esse v\xEDrus causa a doen\xE7a Covid-19."
  sentenceText: {fileID: 8895104907118885627}
  endDialogue: 0
